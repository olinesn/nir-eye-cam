# Editor settings for this repo (https://editorconfig.org). They describe the
# style the code already uses; most editors apply them automatically, some
# (VS Code) need the EditorConfig extension.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
# C, headers, CMake and Python
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
# Nested list items are indented by 2.
indent_size = 2
# Two trailing spaces are a line break in Markdown; don't strip them.
trim_trailing_whitespace = false

# Generated by uv and by the ESP-IDF component manager: leave them as written.
[{host/uv.lock,firmware-p4/dependencies.lock}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
